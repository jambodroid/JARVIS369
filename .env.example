# Copy this file to .env.local and fill in your own values.
# See SETUP.md for step-by-step instructions on where each of these comes from.

# --- Auth ---
# Any long random string -- e.g. `openssl rand -hex 32`. Signs your session cookie.
AUTH_SECRET=

# The password you'll type to log into your own dashboard.
DASHBOARD_PASSWORD=

# --- Supabase (database) ---
# Server-only (never exposed to the browser) -- create a project at supabase.com,
# then Project Settings > API for these two values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Calendar ---
# From a Google Cloud project's OAuth 2.0 Client ID (Web application type).
# See SETUP.md for the exact scopes/redirect URI to configure.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Claude (Jarvis' brain) ---
# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# --- OpenAI (voice transcription + text-to-speech) ---
# platform.openai.com -> API keys
OPENAI_API_KEY=

# --- Daily snapshot cron ---
# Any long random string -- e.g. `openssl rand -hex 32`. Vercel sends this
# same value automatically as a header once set in your Vercel project's
# env vars, to prove cron requests are really coming from Vercel.
CRON_SECRET=

# --- Apple Health (optional -- Health Auto Export webhook) ---
# Any long random string. You'll paste this same value into the Health Auto
# Export app's automation header once the webhook is deployed. Leave blank
# to skip Apple Health integration entirely.
HEALTH_WEBHOOK_SECRET=

# --- Passkeys / Face ID login (optional) ---
# The exact domain you deploy to (no https://, no path), e.g. my-jarvis.vercel.app.
# Defaults to "localhost" for local dev if left blank.
WEBAUTHN_RP_ID=

# --- Local-dev-only test auth bypass (optional) ---
# Lets you mint a session locally without touching your real password, for
# your own scripted testing. Hard-disabled in production regardless of this
# value (the route checks NODE_ENV) -- never set this in Vercel.
DEV_AUTH_BYPASS_SECRET=

# --- Net Worth bank sync (optional, never fully worked in the original build) ---
# TrueLayer Open Banking -- console.truelayer.com. "sandbox" gives you mock
# bank data immediately; real bank data needs TrueLayer's "Go Live" review.
# Net worth accounts can also just be updated manually/via Jarvis without this.
TRUELAYER_ENV=sandbox
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
